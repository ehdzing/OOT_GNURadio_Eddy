<?xml version="1.0"?>
<block>
  <name>Burst Time Tagger CC</name>
  <key>howto_burst_time_tagger_cc</key>
  <category>[HOWTO]</category>

  <import>import howto</import>

  <!-- Bloque con una única factory: 7 parámetros -->
  <make>howto.burst_time_tagger_cc($samp_rate,
                                   $period_s,
                                   $gap_s,
                                   $burst_len,
                                   $t0_usrp,
                                   $offsets,
                                   $lead_s)</make>

  <callback>set_samp_rate($samp_rate)</callback>
  <callback>set_period($period_s)</callback>
  <callback>set_gap($gap_s)</callback>
  <callback>set_burst_len($burst_len)</callback>
  <callback>set_t0_usrp($t0_usrp)</callback>
  <callback>set_offsets($offsets)</callback>
  <callback>set_lead($lead_s)</callback>

  <param>
    <name>Sample rate (Hz)</name>
    <key>samp_rate</key>
    <value>30.72e6</value>
    <type>real</type>
  </param>

  <param>
    <name>Active period (s)</name>
    <key>period_s</key>
    <value>0.01</value>
    <type>real</type>
  </param>

  <param>
    <name>Gap after period (s)</name>
    <key>gap_s</key>
    <value>0.0</value>
    <type>real</type>
  </param>

  <param>
    <name>Burst length (samples)</name>
    <key>burst_len</key>
    <value>30720</value>
    <type>int</type>
  </param>

  <param>
    <name>Initial USRP time (s)</name>
    <key>t0_usrp</key>
    <value>0.0</value>
    <type>real</type>
  </param>

  <param>
    <name>Offsets (s)</name>
    <key>offsets</key>
    <value>[0.0]</value>
    <type>raw</type>
  </param>

  <param>
    <name>Lead ahead (s)</name>
    <key>lead_s</key>
    <value>0.02</value>
    <type>real</type>
  </param>

  <sink>
    <name>in</name>
    <type>complex</type>
  </sink>

  <sink>
    <name>ctrl</name>
    <type>message</type>
    <domain>message</domain>
  </sink>

  <source>
    <name>out</name>
    <type>complex</type>
  </source>

  <doc>
Burst-based tx_time tagger for USRP experiments.

The block takes a complex stream and:

  - passes it to the output unchanged,
  - periodically marks bursts of "Burst length (samples)",
  - for each burst, adds:
      * tx_time (UHD tuple {full_sec, frac_sec}),
      * tx_sob at the first sample,
      * tx_eob at the last sample.

Parameters:

  - Sample rate (Hz) [samp_rate]
  - Active period (s) [period_s]
  - Gap after period (s) [gap_s]
  - Burst length (samples) [burst_len]
  - Initial USRP time (s) [t0_usrp]
  - Offsets (s) [offsets] : list of offsets inside each active period.
  - Lead ahead (s) [lead_s] : additional lead added to tx_time.

All parameters have callbacks and can be updated at runtime.
  </doc>

</block>
