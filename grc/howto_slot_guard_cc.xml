<?xml version="1.0"?>
<block>
  <name>Slot Guard CC</name>
  <key>howto_slot_guard_cc</key>
  <category>[HOWTO]</category>

  <import>import howto</import>
  <make>howto.slot_guard_cc(${sample_rate}, ${numerology_id}, ${samples_per_slot},
                           ${use_pps},
                           ${offset_thr_pass_s}, ${jitter_thr_pass_s},
                           ${offset_thr_dont_s}, ${jitter_thr_dont_s},
                           ${hysteresis_slots},
                           ${dtx_consumes_input},
                           ${allow_dont_consume},
                           ${guard_initial_s},
                           ${lead_s},
                           ${device_addrs})</make>

  <!-- Callbacks for runtime reconfiguration -->
  <callback>set_sample_rate(${sample_rate})</callback>
  <callback>set_numerology_id(${numerology_id})</callback>
  <callback>set_samples_per_slot(${samples_per_slot})</callback>
  <callback>set_use_pps(${use_pps})</callback>

  <callback>set_offset_thr_pass(${offset_thr_pass_s})</callback>
  <callback>set_jitter_thr_pass(${jitter_thr_pass_s})</callback>
  <callback>set_offset_thr_dont(${offset_thr_dont_s})</callback>
  <callback>set_jitter_thr_dont(${jitter_thr_dont_s})</callback>

  <callback>set_hysteresis_slots(${hysteresis_slots})</callback>
  <callback>set_dtx_consumes_input(${dtx_consumes_input})</callback>
  <callback>set_allow_dont_consume(${allow_dont_consume})</callback>

  <callback>set_guard_initial(${guard_initial_s})</callback>
  <callback>set_lead(${lead_s})</callback>

  <!-- Parameters -->
  <param>
    <name>Sample rate (S/s)</name>
    <key>sample_rate</key>
    <value>3.072e7</value>
    <type>float</type>
  </param>

  <param>
    <name>Numerology id (0..5)</name>
    <key>numerology_id</key>
    <value>0</value>
    <type>int</type>
  </param>

  <param>
    <name>Samples per slot (0=auto)</name>
    <key>samples_per_slot</key>
    <value>30720</value>
    <type>int</type>
  </param>

  <param>
    <name>Use PPS per USRP</name>
    <key>use_pps</key>
    <value>[]</value>
    <type>string</type>
  </param>

  <!-- PASS thresholds -->
  <param>
    <name>Offset PASS thr (s)</name>
    <key>offset_thr_pass_s</key>
    <value>1e-4</value>
    <type>float</type>
  </param>

  <param>
    <name>Jitter PASS thr (s)</name>
    <key>jitter_thr_pass_s</key>
    <value>5e-5</value>
    <type>float</type>
  </param>

  <!-- DONT_CONSUME thresholds -->
  <param>
    <name>Offset DONT thr (s)</name>
    <key>offset_thr_dont_s</key>
    <value>7e-4</value>
    <type>float</type>
  </param>

  <param>
    <name>Jitter DONT thr (s)</name>
    <key>jitter_thr_dont_s</key>
    <value>3e-4</value>
    <type>float</type>
  </param>

  <param>
    <name>Hysteresis slots</name>
    <key>hysteresis_slots</key>
    <value>2</value>
    <type>int</type>
  </param>

  <param>
    <name>DTX consumes input</name>
    <key>dtx_consumes_input</key>
    <value>True</value>
    <type>bool</type>
  </param>

  <param>
    <name>Allow DONT_CONSUME (host leads)</name>
    <key>allow_dont_consume</key>
    <value>False</value>
    <type>bool</type>
  </param>

  <param>
    <name>Guard initial (s)</name>
    <key>guard_initial_s</key>
    <value>0.5</value>
    <type>float</type>
  </param>

  <param>
    <name>Lead ahead (s)</name>
    <key>lead_s</key>
    <value>0.02</value>
    <type>float</type>
  </param>

  <param>
    <name>Device address list</name>
    <key>device_addrs</key>
    <value>["serial=32FCD44","serial=32FCD45"]</value>
    <type>string</type>
  </param>

  <!-- Stream ports -->
  <sink>
    <name>in</name>
    <type>complex</type>
  </sink>

  <source>
    <name>out</name>
    <type>complex</type>
  </source>

  <source>
    <name>stats</name>
    <type>message</type>
  </source>

  <source>
    <name>ctrl</name>
    <type>message</type>
  </source>

  <doc>
  "Use PPS per USRP" controla de forma independiente cada dispositivo,
  en el mismo orden que "Device address list":

    - Sintaxis: [True, False], [1,0], ["true","false"], etc.
    - Si solo hay un elemento, por ejemplo [True] y hay 2 USRP:
        USRP[0] -> True (usa set_time_next_pps)
        USRP[1] -> False (usa set_time_now)
    - Lista vacía []: todos los USRP usan set_time_now(0.0).

  El primer USRP (primer address) suele ser el TX; sus tiempos son los
  usados como referencia para calcular offset y jitter en el guard.
  </doc>
</block>
