<?xml version="1.0"?>
<block>
  <name>Frame Burst Source</name>
  <key>howto_frame_burst_source_cc</key>
  <category>[HOWTO]</category>

  <!-- ================= IMPORTS ================= -->
  <!-- SWIG module (C++ blocks) -->
  <import>import howto</import>

  <!-- Optional: allow preamble_expr to call other modules directly -->
  <import>import inatel5g_range</import>

  <!-- ================= MAKE ================= -->
  <!--
    - preamble_expr is evaluated (so you can write: howto.get_preamble() or inatel5g_range.get_preamble())
    - payload is generated WITHOUT eval to avoid NameError for payload_len/payload_mode, etc.
  -->
  <make>howto.frame_burst_source_cc(
          eval(${preamble_expr}),
          howto.get_payload(${payload_len},
                            mode=${payload_mode},
                            marker_len=${marker_len},
                            seed=${payload_seed},
                            amp=${payload_amp},
                            tone_hz=${tone_hz},
                            samp_rate=${samp_rate}),
          ${silence_len},
          ${scale},
          ${enable_tags})</make>

  <!-- ================= CALLBACKS ================= -->
  <callback>set_scale(${scale})</callback>
  <callback>set_silence_len(${silence_len})</callback>
  <callback>set_enable_tags(${enable_tags})</callback>

  <!-- ================= PARAMETERS ================= -->

  <param>
    <name>Preamble Expr</name>
    <key>preamble_expr</key>
    <value>howto.get_preamble()</value>
    <type>string</type>
  </param>

  <param>
    <name>Payload Len</name>
    <key>payload_len</key>
    <value>4362240</value>
    <type>int</type>
  </param>

  <param>
    <name>Payload Mode</name>
    <key>payload_mode</key>
    <value>'marker_qpsk'</value>
    <type>string</type>
  </param>

  <param>
    <name>Marker Len</name>
    <key>marker_len</key>
    <value>128</value>
    <type>int</type>
  </param>

  <param>
    <name>Payload Seed</name>
    <key>payload_seed</key>
    <value>123</value>
    <type>int</type>
  </param>

  <param>
    <name>Payload Amp</name>
    <key>payload_amp</key>
    <value>0.7</value>
    <type>real</type>
  </param>

  <param>
    <name>Tone Hz</name>
    <key>tone_hz</key>
    <value>3e6</value>
    <type>real</type>
  </param>

  <param>
    <name>Sample Rate</name>
    <key>samp_rate</key>
    <value>30.72e6</value>
    <type>real</type>
  </param>

  <param>
    <name>Silence Len (samples)</name>
    <key>silence_len</key>
    <value>153600</value>
    <type>int</type>
  </param>

  <param>
    <name>Scale</name>
    <key>scale</key>
    <value>0.2</value>
    <type>real</type>
  </param>

  <param>
    <name>Enable Tags</name>
    <key>enable_tags</key>
    <value>True</value>
    <type>bool</type>
  </param>

  <!-- ================= OUTPUT PORT ================= -->
  <source>
    <name>out</name>
    <type>complex</type>
  </source>

  <!-- ================= DOC ================= -->
  <doc>
    Source block that generates repeating bursts:

      PREAMBLE -> PAYLOAD -> SILENCE -> repeat

    Preamble is provided by a Python expression (preamble_expr), evaluated at construction time.
    Payload is generated by howto.get_payload(...) with parameters exposed in GRC.
    Optionally emits stream tags:
      - "burst_start" at the first sample of the preamble
      - "payload_start" at the first sample of the payload
  </doc>

</block>
